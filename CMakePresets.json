{
  "version": 3,
  "configurePresets": [
    {
      "name": "ninja-debug",
      "displayName": "macOS Debug (Ninja)",
      "description": "Debug build with symbols, no optimizations",
      "generator": "Ninja",
      "binaryDir": "build-ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "macOS Release (Ninja)",
      "description": "Release build with full optimizations, no symbols",
      "generator": "Ninja",
      "binaryDir": "build-ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ninja-reldeb",
      "displayName": "macOS RelWithDebInfo (Ninja)",
      "description": "Release build with optimizations AND debug symbols",
      "generator": "Ninja",
      "binaryDir": "build-ninja-reldeb",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "displayName": "Build Debug",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "build-release",
      "displayName": "Build Release",
      "configurePreset": "ninja-release"
    },
    {
      "name": "build-reldeb",
      "displayName": "Build RelWithDebInfo",
      "configurePreset": "ninja-reldeb"
    }
  ]
}