
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug RVGRT (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            // IMPORTANT: Point this to the actual executable inside the .app bundle
            "program": "${workspaceFolder}/build-ninja-debug/RVGRT.app/Contents/MacOS/RVGRT",
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                // These help catch GPU command buffer errors early
                "METAL_DEVICE_WRAPPER_TYPE": "1",
                "MTL_SHADER_VALIDATION": "1"
            },
            // If you don't have a build task set up, remove this line:
            // "preLaunchTask": "Build" 
        }
    ]
}

